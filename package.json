{
  "name": "api-anything",
  "version": "0.1.0",
  "description": "Turn web-based business systems without an API into typed APIs and command-line operations for AI agents, by analyzing the traffic of a normal browser session.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "api-anything": "./src/cli.ts"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "cli",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "har",
    "openapi",
    "erp",
    "integration",
    "automation",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtbun/api-anything.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "playwright": "^1.64.0"
  }
}
